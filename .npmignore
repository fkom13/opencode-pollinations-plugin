# NPM Ignore
# Files to exclude from the NPM package to keep it lightweight.

# Source Code (we ship compiled dist/)
src/
scripts/
tests/
tsconfig.json

# Documentation (Available on GitHub, redundant in package)
docs/
docs/TECHNICAL_SECRETS_REMBG.md
_archs/
TECHNICAL_MANUAL.md
AGENT.md
CHANGELOG.md
CONTRIBUTING.md
# LICENSE is automatically included by npm
# README.md is automatically included by npm

# Versioning & Dev Tools
.gencodedoc/
.gencodedoc.yaml
.npmrc
.git/
.gitignore
.github/

# Logs & Temp
logs/
*.log
npm-debug.log*
opencode-pollinations-plugin_tree_code.md

# Editor Configs
.vscode/
.idea/
*.swp
.DS_Store
