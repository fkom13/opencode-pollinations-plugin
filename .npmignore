# NPM Ignore
# Files to exclude from the NPM package to keep it lightweight.

# Archives & Internal/Obsolete Docs
_archs/
docs/studies/
docs/issues/
docs/vision/ideas_archive/

# Logs & Temp files
logs/
*.log
npm-debug.log*
.gencodedoc/
.gencodedoc.yaml

# Development Configs
tsconfig.json
.eslintrc.json
.prettierrc
jest.config.js
scripts/

# Source (Map files etc - Optional, but keeping src/ is often good for debugging)
# We keep src/ for sourcemaps if needed, but dist/ is the main artifact.

# Tests
tests/
test/
__tests__/

# Editor Configs
.vscode/
.idea/
*.swp
.DS_Store
