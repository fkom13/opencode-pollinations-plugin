# NPM Ignore
# Files to exclude from the NPM package to keep it lightweight.

# Source Code (we ship compiled dist/)
src/
scripts/
tests/
tsconfig.json

# Documentation (Available on GitHub, redundant in package)
docs/
_archs/
TECHNICAL_MANUAL.md
AGENT.md
CHANGELOG.md
CONTRIBUTING.md
*.md
!README.md
!LICENSE.md
*.code-workspace

# Versioning & Dev Tools
.gencodedoc/
.gencodedoc.yaml
.npmrc
.git/
.gitignore
.github/
.vscode/
.vscode-test/
.idea/

# Logs & Environment
logs/
*.log
npm-debug.log*
.env
.env.*
config.json
.pollinations/

# Editor Configs & OS
*.swp
.DS_Store
Thumbs.db
