---
title: "🔵 Architecture Cible — Plugin Pollinations (Post-Audit)"
---
flowchart TD

    %% ─────────────────────────────────────────
    %% SECTION 1 : Démarrage plugin
    %% ─────────────────────────────────────────
    subgraph S1["🔌 Démarrage plugin"]
        direction TB
        A["fetchAllModels()\n── /text/models      → text/chat/search/audio-chat (métadonnées complètes)\n── /models/image     → image et vidéo\n── /models/audio     → TTS et musique\n📄 voir fetch_strategy.md — critères de tri par champs"]
        B{Réponse OK ?}
        C["Écrire cache JSON local\n~/.config/opencode/\npollinations_models_cache.json"]
        D["Charger dernier\ncache JSON local"]
        E["Merger model-overrides.json\npatches manuels\n(duration, voices, etc.)"]

        REG1["📦 REGISTRE 1 — ModelRegistry  (dynamique, live)\n════════════════════════════════════════\nAlimenté par l'API Pollinations  ·  Fallback : cache JSON\n────────────────────────────────────────\nPar modèle :\n  • id / name          → identité\n  • type               → text | image | video | audio | music\n  • modalités          → input/output supportés\n  • capabilities       → ex: streaming, vision, reasoning…\n  • cost               → coût par token / requête\n  • isAvailable        → actif ou non\n════════════════════════════════════════\n🎯 Ces données sont injectées dynamiquement\n   dans la définition des Tools LLM au runtime"]

        A --> B
        B -->|"✅ Oui"| C
        B -->|"❌ Non (timeout/erreur)"| D
        C --> E
        D --> E
        E --> REG1
    end

    %% ─────────────────────────────────────────
    %% REGISTRE 2 — paramètres empiriques
    %% ─────────────────────────────────────────
    subgraph S_REG2["📋 REGISTRE 2 — models_particularity.json  (empirique, évolutif)"]
        direction TB
        REG2_DESC["Paramètres découverts ou documentés par test\n════════════════════════════════════════\nPar modèle (enrichi progressivement) :\n  • enums précis       → ex: durées réelles supportées [4,6,8]\n  • tailles validées   → ex: widths/heights qui marchent vraiment\n  • voix disponibles   → enum testé et confirmé\n  • paid_only          → boolean\n  • params interdits   → ce que l'API rejette silencieusement\n════════════════════════════════════════\n⚠️  L'API Pollinations change souvent :\n    ce registre se construit par découverte active\n    via le Tool Adaptatif (voir ci-dessous)"]
    end

    %% ─────────────────────────────────────────
    %% TOOL ADAPTATIF — découverte & écriture
    %% ─────────────────────────────────────────
    subgraph S_ADAPT["🧪 Tool Adaptatif — Découverte & Mise à jour  (à implémenter)"]
        direction TB

        subgraph PROBE["🔬 Phase Test (beta)"]
            direction LR
            T1["Envoyer requête\ntest sur modèle\nbeta / inconnu"]
            T2["Observer réponse\n(succès / erreur\n/ comportement)"]
            T3["Identifier params\nqui fonctionnent\nréellement"]
            T1 --> T2 --> T3
        end

        subgraph WRITE["✍️ Phase Écriture (CRUD)"]
            direction LR
            CRUD_R["🔍 READ\nConsulter\nl'état actuel"]
            CRUD_U["✏️ UPDATE\nCorriger enums,\nparams, capacités"]
            CRUD_C["➕ CREATE\nNouveau modèle\nbeta découvert"]
            CRUD_D["🗑️ DELETE\nModèle obsolète\nou retiré de l'API"]
            CRUD_R --- CRUD_U --- CRUD_C --- CRUD_D
        end

        PROBE --> WRITE
    end

    %% ─────────────────────────────────────────
    %% SECTION 2 : Appel d'outil
    %% ─────────────────────────────────────────
    subgraph S2["🔧 Appel d'outil"]
        direction TB
        G["Modèle demandé\npar l'IA"]
        H_R2{"Dans\nRegistre 2 ?"}
        PARAMS_OK["✅ Paramètres libres injectés\n(enums précis, tailles, voix…\ndepuis Registre 2)"]
        PARAMS_BETA["⚠️ Mode beta\nParams par défaut uniquement\nnon fournir params libres\n→ candidat pour Tool Adaptatif"]
        CG_entry["Cost Guard"]

        G --> H_R2
        H_R2 -->|"✅ Oui"| PARAMS_OK
        H_R2 -->|"❌ Non"| PARAMS_BETA
        PARAMS_OK --> CG_entry
        PARAMS_BETA --> CG_entry
    end

    %% ─────────────────────────────────────────
    %% SECTION 3 : Cost Guard
    %% ─────────────────────────────────────────
    subgraph S3["💰 Cost Guard (checks indépendants)"]
        direction TB
        CHK1{"Check 1 :\nenablePaidTools\n= false ?"}

        subgraph BLK_PAID["Modèle paid_only 💎"]
            PAYTOOL["PAYTOOL DÉSACTIVÉ\nDemandez à l'user de l'activer\npour utiliser ce modèle"]
        end

        subgraph BLK_QUOTA["Quotas free-tier épuisés"]
            MSG_QUOTA["⚠️ Message quotas\nFree-tier épuisé,\nFacturation wallet"]
        end

        CHK2{"Check 2 :\ncostConfirmation\n= true ?"}
        CONFIRM["⚠️ Confirmation requise\nCoût estimé X.XX 💰\n(seuil Y.YY) 😮"]
        PROCEED["cost ≤ threshold\nou confirm=false"]
        EXEC["Exécuter la requête\nvers gen.pollinations.ai"]

        CHK1 -->|"ok paid ou quota"| CHK2
        CHK1 --> BLK_PAID
        CHK1 --> BLK_QUOTA
        CHK2 -->|"cost > costThreshold"| CONFIRM
        CHK2 --> PROCEED
        CONFIRM --> EXEC
        PROCEED --> EXEC
    end

    %% ─────────────────────────────────────────
    %% SECTION 4 : Résultat
    %% ─────────────────────────────────────────
    subgraph S4["🎁 Résultat"]
        direction TB
        RES["Retour à l'IA avec ✅\nFichier généré 💾  Coût réel ⚠️\ncostWarning (si applicable)"]
        MASK["Masquer API key\ndans /pollinations config\n(n$chars***4chars)"]
        RES --> MASK
    end

    %% ─────────────────────────────────────────
    %% LIENS INTER-SECTIONS
    %% ─────────────────────────────────────────
    REG1        -->|"injecté dans\nles Tools LLM"| G
    REG2_DESC   -.->|"consulté\nlors de l'appel"| H_R2
    PARAMS_BETA -.->|"modèle beta détecté\n→ lancer découverte"| S_ADAPT
    WRITE       ==>|"écrit résultats\ndans le registre"| REG2_DESC
    CG_entry    --> CHK1
    EXEC        --> RES

    %% ─────────────────────────────────────────
    %% STYLES
    %% ─────────────────────────────────────────
    classDef default  fill:#3a3a3a,stroke:#888,color:#eee,font-size:12px
    classDef decision fill:#1a1a1a,stroke:#aaa,color:#eee
    classDef reg1     fill:#1a2a3a,stroke:#4488cc,color:#aaddff,stroke-width:2px
    classDef reg2     fill:#2a1a3a,stroke:#aa44cc,color:#ddaaff,stroke-width:2px
    classDef adapt    fill:#2a1a1a,stroke:#cc6644,color:#ffccaa,stroke-width:2px
    classDef crud     fill:#1a3a2a,stroke:#44cc88,color:#aaffcc,stroke-width:2px
    classDef warning  fill:#3a3a1a,stroke:#ffaa00,color:#ffdd88
    classDef paytool  fill:#1a2a1a,stroke:#44ff44,color:#88ff88
    classDef beta     fill:#3a2a1a,stroke:#ff8844,color:#ffccaa

    class B,H_R2,CHK1,CHK2 decision
    class REG1 reg1
    class REG2_DESC reg2
    class T1,T2,T3 adapt
    class CRUD_R,CRUD_U,CRUD_C,CRUD_D crud
    class MSG_QUOTA,CONFIRM warning
    class PAYTOOL paytool
    class PARAMS_BETA beta
